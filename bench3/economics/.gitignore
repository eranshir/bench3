__pycache__/
*.pyc
agentic_work/

# Private local workspaces, raw sessions, and per-run evidence signing keys.
agentic_runs/
agentic_sessions/
agentic_artifacts/
agentic_results/
results/
runs/
aegis_enforced_runs/
**/evidence-state/
*.pkcs8
*.pem
*.key
.env*
auth.json
