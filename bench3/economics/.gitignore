# Keep aggregate reports and round checkpoints, not active process state.
campaigns/current.json
campaigns/*/reasoning/
campaigns/*/toolloop/
campaigns/*/process.json
campaigns/*/manifest.initial.json
campaigns/*/transport-events.jsonl
campaigns/*/worker.*
toolloop/infra_attempts/
toolloop/failures.jsonl
*.log
*.lock
*.tmp

# Fresh linked ladders: publish aggregates, not raw chain or signing state.
ladder_campaigns/current.json
ladder_campaigns/*/chain_runs/
ladder_campaigns/*/chain_records/
ladder_campaigns/*/process.json
ladder_campaigns/*/worker.*
