from walker import iter_nodes, collect_values, max_depth

# Lazy: taking the first item from an infinitely deep tree must not hang.
inf = {\"value\": 0}
node = inf
for _ in range(1000):
    node[\"children\"] = [{\"value\": 1}]
    node = node[\"children\"][0]
node[\"children\"] = []

it = iter_nodes(inf)
assert next(it) == (0, 0)
assert next(it) == (1, 1)
assert next(it) == (1, 2)
print(\"lazy ok\")

# Iterative: 10,000-deep tree must not blow the recursion limit.
deep = {\"value\": 0}
node = deep
for i in range(9999):
    node[\"children\"] = [{\"value\": i + 1}]
    node = node[\"children\"][0]
node[\"children\"] = []

assert collect_values(deep)[-1] == 9999
assert max_depth(deep) == 9999
print(\"deep ok\")

# Ordering preserved.
TREE = {
    \"value\": \"a\",
    \"children\": [
        {\"value\": \"b\", \"children\": [{\"value\": \"c\", \"children\": []}]},
        {\"value\": \"d\", \"children\": []},
    ],
}
assert list(iter_nodes(TREE)) == [(\"a\", 0), (\"b\", 1), (\"c\", 2), (\"d\", 1)]
assert collect_values(TREE) == [\"a\", \"b\", \"c\", \"d\"]
assert max_depth(TREE) == 2
print(\"order ok\")
