import os
from unittest.mock import patch

from app.loader import load_config

cases = [
    ({}, None, {\"host\": \"localhost\", \"port\": 8000, \"debug\": False}),
    ({\"APP_HOST\": \"example.com\", \"APP_PORT\": \"9001\", \"APP_DEBUG\": \"yes\"}, None,
     {\"host\": \"example.com\", \"port\": 9001, \"debug\": True}),
    ({\"APP_DEBUG\": \"false\", \"APP_UNKNOWN\": \"ignored\"}, {\"debug\": True, \"port\": 7000},
     {\"host\": \"localhost\", \"port\": 7000, \"debug\": True}),
]
for env, overrides, expected in cases:
    with patch.dict(os.environ, env, clear=True):
        config = load_config(overrides)
        assert config.as_dict() == expected, (config.as_dict(), expected)
        assert config.get(\"port\") == expected[\"port\"]

for raw, expected in [(\"1\", True), (\"true\", True), (\"True\", True), (\"yes\", True),
                      (\"0\", False), (\"false\", False), (\"False\", False), (\"no\", False)]:
    with patch.dict(os.environ, {\"APP_DEBUG\": raw}, clear=True):
        assert load_config().get(\"debug\") is expected

print(\"config checks passed\")
