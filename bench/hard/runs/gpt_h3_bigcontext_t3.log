from decimal import Decimal
from ledgerkit import analytics, catalog, fx, pricing, reporting, repository, tenants
from ledgerkit.money import Money

cat = catalog.default_catalog()
tolerance = Decimal(\"1e-24\")

for currency, rate in fx.RATES.items():
    assert fx.convert(Money(1, \"USD\"), currency).amount == rate
    assert fx.convert(Money(rate, currency), \"USD\").amount == Decimal(1)

for source in fx.supported():
    for target in fx.supported():
        expected = fx.rate_for(target) / fx.rate_for(source)
        assert fx.cross_rate(source, target) == expected
        converted = fx.convert(Money(1, source), target)
        assert abs(converted.amount - expected) <= tolerance
        rounded = reporting.round_for_report(converted)
        assert rounded.is_quantized()
        assert rounded.currency == target

expected = {
    \"acme\": {
        \"rows\": [\"244.68\", \"1174.50\", \"212.46\", \"432.00\"],
        \"total\": \"2063.64\",
    },
    \"kitsune\": {
        \"rows\": [\"98439\", \"43120\", \"35856\"],
        \"total\": \"177415\",
    },
}

for tenant in tenants.all_tenants():
    orders = repository.for_tenant(tenant.tenant_id)
    report = reporting.tenant_report(tenant, orders, cat)
    assert report[\"total\"].is_quantized()
    assert all(row[\"reported\"].is_quantized() for row in report[\"rows\"])
    for order in orders:
        breakdown = pricing.price_breakdown(order, cat, tenant)
        assert breakdown[\"tax\"] == pricing.order_tax(order, cat, tenant)
        assert breakdown[\"total\"] == pricing.order_total(order, cat, tenant)
        assert breakdown[\"total\"] == (
            breakdown[\"taxable\"] + breakdown[\"tax\"]).quantized()
    if tenant.tenant_id in expected:
        wanted = expected[tenant.tenant_id]
        assert [str(r[\"reported\"].amount) for r in report[\"rows\"]] == wanted[\"rows\"]
        assert str(report[\"total\"].amount) == wanted[\"total\"]

print(\"all expected totals and cross-tenant/currency invariants passed\")
