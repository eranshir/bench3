        assert breakdown[\"total\"] == pricing.order_total(order, cat, tenant)
        assert breakdown[\"total\"] == (
            breakdown[\"taxable\"] + breakdown[\"tax\"]).quantized()
    largest = analytics.largest_order(orders, cat, tenant)
    assert largest in orders

print(\"all cross-currency, precision, and pricing invariants passed\")
