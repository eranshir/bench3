from decimal import Decimal
from ledgerkit import analytics, catalog, fx, pricing, reporting, repository, tenants
from ledgerkit.money import Money, exponent_for

cat = catalog.default_catalog()

# The quoted table is currency units per USD.
for currency, rate in fx.RATES.items():
    converted = fx.convert(Money(1, \"USD\"), currency)
    assert converted.amount == rate, (currency, converted, rate)

# Cross-rates must round-trip exactly at Decimal precision for table entries.
for source in fx.supported():
    for target in fx.supported():
        amount = Money(fx.rate_for(source), source)
        converted = fx.convert(amount, target)
        assert converted.amount == fx.rate_for(target), (source, target, converted)

for tenant in tenants.all_tenants():
