import math, random
from analytics import rolling_median, window_distinct_counts

def old_median(values, window):
    if window <= 0:
        raise ValueError('window must be positive')
    out=[]
    for i in range(len(values)-window+1):
        chunk=sorted(values[i:i+window]); mid=window//2
        if window%2: out.append(float(chunk[mid]))
        else: out.append((chunk[mid-1]+chunk[mid])/2.0)
    return out

def old_distinct(values, window):
    if window <= 0:
        raise ValueError('window must be positive')
    return [len(set(values[i:i+window])) for i in range(len(values)-window+1)]

def same(a,b):
    if len(a)"'!=len(b): return False
    for x,y in zip(a,b):
        if isinstance(x,float) and isinstance(y,float) and math.isnan(x) and math.isnan(y): continue
        if x != y or (x == 0 and math.copysign(1,x) != math.copysign(1,y)): return False
    return True

rng=random.Random(1234)
choices=[-10,-1,0,1,2,10,-0.0,0.0,-1.5,2.5,float('"'inf'),float('-inf'),True,False]
for n in range(30):
    for w in range(1,n+3):
        for _ in range(100):
            xs=[rng.choice(choices) for _ in range(n)]
            a,b=old_median(xs,w),rolling_median(xs,w)
            assert same(a,b),(xs,w,a,b)
            assert old_distinct(xs,w)==window_distinct_counts(xs,w)

cases=[([],0), ([1],-1), ([1,2],1.5), ([1,[]],1), ([1,float('nan'),2],2), ((1,2,3),2)]
for fn,new in [(old_median,rolling_median),(old_distinct,window_distinct_counts)]:
    for values,w in cases:
        try: expected=('ok',fn(values,w))
        except Exception as e: expected=('err',type(e),str(e))
        try: actual=('ok',new(values,w))
        except Exception as e: actual=('err',type(e),str(e))
        if expected[0]=='ok' and actual[0]=='ok':
            assert same(expected[1],actual[1])
        else: assert expected==actual,(fn.__name__,values,w,expected,actual)
print('differential tests passed')
