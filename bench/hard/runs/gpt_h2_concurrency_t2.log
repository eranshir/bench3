import threading
import time
from pipeline import Ledger, WorkerPool

# Repeat the original stress patterns enough to expose scheduling races.
for _ in range(25):
    led = Ledger({'a': 1000, 'b': 1000})
    threads = [
        threading.Thread(target=lambda: [led.transfer('a', 'b', 1) for _ in range(2000)]),
        threading.Thread(target=lambda: [led.transfer('b', 'a', 1) for _ in range(2000)]),
    ]
    for t in threads: t.start()
    for t in threads:
        t.join(5)
        assert not t.is_alive()
    assert led.total() == 2000

# Deposits and their audit snapshots are atomic and complete.
led = Ledger({'a': 0, 'b': 0})
threads = [threading.Thread(target=lambda account=a: [led.deposit(account, 1) for _ in range(1000)])
           for a in ('a', 'b', 'a', 'b')]
for t in threads: t.start()
for t in threads: t.join()
assert led.total() == 4000
assert len(led.audit) == 4000
assert sorted(row['ledger_total'] for row in led.audit) == list(range(1, 4001))

# An overdraw race admits only one transfer, and a self-transfer cannot deadlock.
led = Ledger({'a': 10, 'b': 0, 'c': 0})
answers = []
threads = [threading.Thread(target=lambda dst=dst: answers.append(led.transfer('a', dst, 10)))
           for dst in ('b', 'c')]
for t in threads: t.start()
for t in threads: t.join()
assert sorted(answers) == [False, True]
assert led.transfer('a', 'a', 1) is False
assert Ledger({'a': 10}).transfer('a', 'a', 10) is True

# Pool produces exactly one entry per task, remains reusable, survives task errors,
# and executes rather than serializing the callables.
pool = WorkerPool(8)
for i in range(1000): pool.submit(lambda i=i: i)
assert sorted(pool.run()) == list(range(1000))
for i in range(20): pool.submit(lambda i=i: i * 3)
assert sorted(pool.run()) == [i * 3 for i in range(20)]

pool = WorkerPool(4)
pool.submit(lambda: 1)
pool.submit(lambda: 1 / 0)
pool.submit(lambda: 3)
results = pool.run()
assert len(results) == 3 and any(isinstance(x, ZeroDivisionError) for x in results)

pool = WorkerPool(4)
for _ in range(4): pool.submit(lambda: time.sleep(.15))
started = time.monotonic(); pool.run(); elapsed = time.monotonic() - started
assert elapsed < .45, elapsed
print('all concurrency checks passed; parallel batch elapsed:', round(elapsed, 3), 's')
