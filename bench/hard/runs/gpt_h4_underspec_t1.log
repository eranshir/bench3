from filterlang import evaluate

cases = [
    (\"age > 30 and (city == 'NY' or city == 'LA')\", {\"age\": 41, \"city\": \"LA\"}, True),
    (\"not banned and score >= 4.5\", {\"banned\": False, \"score\": 4.5}, True),
    (\"country in ['US', 'CA']\", {\"country\": \"CA\"}, True),
    (\"country not in ['US', 'CA']\", {\"country\": \"GB\"}, True),
    (\"tags not contains 'staff'\", {\"tags\": [\"vip\"]}, True),
    (\"profile.city = \\\"New York\\\"\", {\"profile\": {\"city\": \"New York\"}}, True),
    (\"deleted is null\", {\"deleted\": None}, True),
    (\"enabled == TRUE\", {\"enabled\": True}, True),
    (\"temperature >= -2.5e1\", {\"temperature\": -20}, True),
    (\"name == 'O\\\\'Brien'\", {\"name\": \"O'Brien\"}, True),
    (\"missing "'!= 3", {}, False),
    ("missing is not null", {}, False),
    ("age > '"'old'\", {\"age\": 10}, False),
    (\"true or missing > 2\", {}, True),
    (\"false and missing > 2\", {}, False),
    (\"10 < age <= 20\", {\"age\": 15}, True),
]
for expression, record, expected in cases:
    actual = evaluate(expression, record)
    assert actual is expected, (expression, actual, expected)

bad = [\"\", \"age >\", \"(age > 2\", \"age && true\", \"name == 'broken\", \"x in [1 2]\"]
for expression in bad:
    try:
        evaluate(expression, {})
    except ValueError:
        pass
    else:
        raise AssertionError(f\"accepted invalid expression: {expression"'!r}")
print(f"additional cases: {len(cases)} valid and {len(bad)} invalid passed")
