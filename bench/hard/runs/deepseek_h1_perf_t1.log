@@ -0,0 +1,112 @@
+import math
+import random
+
+import analytics as new
+from analytics_orig import rolling_median as orig_median
+from analytics_orig import window_distinct_counts as orig_distinct
+
+
+def same_value(a, b):
+    if isinstance(a, float) and isinstance(b, float):
+        if math.isnan(a) and math.isnan(b):
+            return True
+    return a == b
+
+
+def same_result(x, y):
+    return len(x) == len(y) and all(same_value(a, b) for a, b in zip(x, y))
+
+
+def check(fn_new, fn_orig, values, window):
+    try:
+        r_new = fn_new(values, window)
+        new_exc = None
+    except Exception as e:
+        r_new = None
+        new_exc = (type(e), str(e))
+    try:
+        r_orig = fn_orig(values, window)
+        orig_exc = None
+    except Exception as e:
+        r_orig = None
+        orig_exc = (type(e), str(e))
+
+    ok = True
+    if new_exc or orig_exc:
+        ok = new_exc == orig_exc
+        if not ok:
+            print("ERROR", fn_new.__name__, repr(values)[:60], window)
+            print("  new:", new_exc)
+            print("  old:", orig_exc)
+    elif not same_result(r_new, r_orig):
+        ok = False
+        print("MISMATCH", fn_new.__name__, repr(values)[:60], window)
+        for idx, (a, b) in enumerate(zip(r_new, r_orig)):
+            if not same_value(a, b):
+                print("  first diff at", idx, "new:", a, "old:", b)
+                break
+    return ok
+
+
+random.seed(12345)
+ok = True
+
+# Edge cases
+edge_values = [
+    [],
+    [5],
+    [1, 2],
+    [3, 1, 2],
+    [2, 2, 2, 2],
+    [1, 1, 2, 2],
+    [0, -1, -1, 5, 3],
+    [1.5, -2.25, 1.5, 0.0, -0.0, 3.25],
+    [0.0, -0.0, 0.0],
+    [10, 1, 1, 1, 10, 1],
+]
+edge_windows = [1, 2, 3, 4, 5, 6, 7, 8]
+for v in edge_values:
+    for w in edge_windows:
+        ok &= check(new.rolling_median, orig_median, v, w)
+        ok &= check(new.window_distinct_counts, orig_distinct, v, w)
+
+# Error behaviour
+for v in ([], [1, 2, 3], [1.5]):
+    for w in (0, -1, -5):
+        ok &= check(new.rolling_median, orig_median, v, w)
+        ok &= check(new.window_distinct_counts, orig_distinct, v, w)
+
+# Float window (original raises TypeError via range(); new should too)
+for v in ([1, 2, 3, 4, 5], []):
+    for w in (1.5, 2.0, 6.0):
+        ok &= check(new.rolling_median, orig_median, v, w)
+        ok &= check(new.window_distinct_counts, orig_distinct, v, w)
+
+# Random numeric fuzz
+for trial in range(400):
+    n = random.randint(0, 60)
+    kind = random.choice(["int", "small_int", "float", "mixed", "neg"])
+    if kind == "int":
+        vals = [random.randint(-50, 50) for _ in range(n)]
+    elif kind == "small_int":
+        vals = [random.randint(0, 3) for _ in range(n)]
+    elif kind == "float":
+        vals = [round(random.uniform(-10, 10), 2) for _ in range(n)]
+    elif kind == "mixed":
+        vals = [random.choice([random.randint(-5, 5), round(random.uniform(-5, 5), 2)])
+                for _ in range(n)]
+    else:
+        vals = [random.randint(-10, 0) for _ in range(n)]
+    w = random.randint(0, n + 5)
+    ok &= check(new.rolling_median, orig_median, vals, w)
+    ok &= check(new.window_distinct_counts, orig_distinct, vals, w)
+
+# Large random spot checks (exact equality on big inputs)
+for trial in range(6):
+    n = random.randint(5000, 20000)
+    vals = [random.randint(0, 1000) for _ in range(n)]
+    w = random.randint(1, 500)
+    ok &= check(new.rolling_median, orig_median, vals, w)
+    ok &= check(new.window_distinct_counts, orig_distinct, vals, w)
+
+print("ALL OK" if ok else "FAILURES FOUND")
