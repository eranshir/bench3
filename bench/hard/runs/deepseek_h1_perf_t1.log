codex
The distinct-count function passes, but the median has a bug: when an element is pushed straight into the `high` heap, I never updated its `in_low` marker, so drops decrement the wrong half. I'll fix that and also make non-integer-window errors raise the exact same TypeError the original does.
apply patch
patch: completed
/Users/eranshir/Documents/Projects/deepseek/bench/hard/work/deepseek_h1_perf_t1/analytics.py
diff --git a//tmp/fuzz_analytics.py b//tmp/fuzz_analytics.py
new file mode 100644
index 0000000000000000000000000000000000000000..0b36869a978f265aab69a81da860fb299fb4f671
--- /dev/null
+++ b//tmp/fuzz_analytics.py
@@ -0,0 +1,112 @@
+import math
+import random
+
+import analytics as new
+from analytics_orig import rolling_median as orig_median
+from analytics_orig import window_distinct_counts as orig_distinct
+
+
+def same_value(a, b):
+    if isinstance(a, float) and isinstance(b, float):
+        if math.isnan(a) and math.isnan(b):
+            return True
+    return a == b
+
+
+def same_result(x, y):
+    return len(x) == len(y) and all(same_value(a, b) for a, b in zip(x, y))
+
+
+def check(fn_new, fn_orig, values, window):
+    try:
+        r_new = fn_new(values, window)
+        new_exc = None
+    except Exception as e:
+        r_new = None
+        new_exc = (type(e), str(e))
+    try:
+        r_orig = fn_orig(values, window)
+        orig_exc = None
+    except Exception as e:
+        r_orig = None
+        orig_exc = (type(e), str(e))
+
+    ok = True
+    if new_exc or orig_exc:
+        ok = new_exc == orig_exc
+        if not ok:
+            print("ERROR", fn_new.__name__, repr(values)[:60], window)
+            print("  new:", new_exc)
+            print("  old:", orig_exc)
+    elif not same_result(r_new, r_orig):
+        ok = False
+        print("MISMATCH", fn_new.__name__, repr(values)[:60], window)
+        for idx, (a, b) in enumerate(zip(r_new, r_orig)):
+            if not same_value(a, b):
+                print("  first diff at", idx, "new:", a, "old:", b)
+                break
+    return ok
+
+
+random.seed(12345)
+ok = True
+
+# Edge cases
+edge_values = [
+    [],
+    [5],
+    [1, 2],
+    [3, 1, 2],
+    [2, 2, 2, 2],
+    [1, 1, 2, 2],
+    [0, -1, -1, 5, 3],
+    [1.5, -2.25, 1.5, 0.0, -0.0, 3.25],
+    [0.0, -0.0, 0.0],
+    [10, 1, 1, 1, 10, 1],
+]
+edge_windows = [1, 2, 3, 4, 5, 6, 7, 8]
+for v in edge_values:
+    for w in edge_windows:
+        ok &= check(new.rolling_median, orig_median, v, w)
+        ok &= check(new.window_distinct_counts, orig_distinct, v, w)
+
+# Error behaviour
+for v in ([], [1, 2, 3], [1.5]):
+    for w in (0, -1, -5):
+        ok &= check(new.rolling_median, orig_median, v, w)
+        ok &= check(new.window_distinct_counts, orig_distinct, v, w)
+
+# Float window (original raises TypeError via range(); new should too)
+for v in ([1, 2, 3, 4, 5], []):
