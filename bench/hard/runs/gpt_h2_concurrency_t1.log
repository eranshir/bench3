import threading
from pipeline import WorkerPool

pool = WorkerPool(4)
for i in range(50):
    def parent(i=i):
        pool.submit(lambda i=i: ('child', i))
        return ('parent', i)
    pool.submit(parent)
results = pool.run()
assert len(results) == 100, len(results)
assert sum(value[0] == 'parent' for value in results) == 50
assert sum(value[0] == 'child' for value in results) == 50

# A subsequent batch runs cleanly and preserves the pool's established,
# cumulative results behavior.
for i in range(25):
    pool.submit(lambda i=i: i)
assert len(pool.run()) == 125

try:
    WorkerPool(0)
except ValueError:
    pass
else:
    raise AssertionError('zero-worker pools must not silently lose work')
print('repeated stress and worker lifecycle checks: ok')
