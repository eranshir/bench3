import threading
import time
from pipeline import Ledger, WorkerPool

# Re-run the supplied workload enough times to expose timing-sensitive bugs.
for _ in range(10):
    led = Ledger({'treasury': 0})
    threads = [threading.Thread(target=lambda: [led.deposit('treasury', 1) for _ in range(2000)]) for _ in range(8)]
    for thread in threads:
        thread.start()
    for thread in threads:
        thread.join(5)
    assert not any(thread.is_alive() for thread in threads)
    assert led.balances['treasury'] == 16000
    assert led.total() == 16000
    assert len(led.audit) == 16000
    assert led.audit[-1]['ledger_total'] == 16000

# Opposing transfers terminate and preserve money.
for _ in range(10):
    led = Ledger({'a': 10000, 'b': 10000})
    threads = [
        threading.Thread(target=lambda: [led.transfer('a', 'b', 1) for _ in range(3000)]),
        threading.Thread(target=lambda: [led.transfer('b', 'a', 1) for _ in range(3000)]),
    ]
    for thread in threads:
        thread.start()
    for thread in threads:
        thread.join(5)
    assert not any(thread.is_alive() for thread in threads)
    assert led.total() == 20000
    assert sum(led.balances.values()) == 20000

# Concurrent overdraw attempts cannot make the source negative.
led = Ledger({'a': 10, 'b': 0})
outcomes = []
lock = threading.Lock()
def attempt():
    value = led.transfer('a', 'b', 1)
    with lock:
        outcomes.append(value)
threads = [threading.Thread(target=attempt) for _ in range(100)]
for thread in threads:
    thread.start()
for thread in threads:
    thread.join()
assert outcomes.count(True) == 10
assert outcomes.count(False) == 90
assert led.balances == {'a': 0, 'b': 10}
assert led.transfer('a', 'a', 1) is False
assert led.transfer('b', 'b', 1) is True

# Every queued callable runs exactly once; failures do not kill workers.
pool = WorkerPool(8)
seen = []
seen_lock = threading.Lock()
def task(i):
    time.sleep((i % 5) * 0.0001)
    with seen_lock:
        seen.append(i)
    return i * 2
for i in range(1000):
    pool.submit(lambda i=i: task(i))
pool.submit(lambda: 1 / 0)
results = pool.run()
assert sorted(seen) == list(range(1000))
assert len(results) == 1001
assert sum(isinstance(value, ZeroDivisionError) for value in results) == 1
print('focused concurrency checks: ok')
