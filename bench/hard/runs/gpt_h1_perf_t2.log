)

def bits(x):
    return struct.pack('>d', x)

random.seed(20260801)
pool = [-10**100, -9, -1, 0, 1, 2, 9, 10**100, False, True,
        -math.inf, -3.5, -0.0, 0.0, 2.25, math.inf]
median_cases = 0
distinct_cases = 0
for n in range(30):
    for _ in range(150):
        values = [random.choice(pool) for _ in range(n)]
        for window in range(1, n + 3):
            try:
                expected = _rolling_median_reference(values, window)
            except Exception as exc:
                try:
                    rolling_median(values, window)
                except Exception as got:
                    assert (type(got), str(got)) == (type(exc), str(exc)), (values, window, exc, got)
                else:
                    raise AssertionError(('missing median exception', values, window, exc))
            else:
                actual = rolling_median(values, window)
                assert len(actual) == len(expected)
                assert all(bits(a) == bits(e) for a, e in zip(actual, expected)), (values, window, expected, actual)
            median_cases += 1

            expected = _window_distinct_counts_reference(values, window)
            actual = window_distinct_counts(values, window)
            assert actual == expected, (values, window, expected, actual)
            distinct_cases += 1

# NaNs and non-numeric/unhashable values exercise the literal reference path.
for values in ([1.0, math.nan, 2.0, math.nan], [3, 'x', 1], [[1], [1]]):
    for window in range(1, 6):
        for fast, ref in ((rolling_median, _rolling_median_reference),
                          (window_distinct_counts, _window_distinct_counts_reference)):
            try:
                expected = ref(values, window)
            except Exception as exc:
                try:
                    fast(values, window)
                except Exception as got:
                    assert (type(got), str(got)) == (type(exc), str(exc))
                else:
                    raise AssertionError(('missing fallback exception', fast.__name__, values, window))
            else:
                actual = fast(values, window)
                if fast is rolling_median:
                    assert all(bits(a) == bits(e) for a, e in zip(actual, expected))
                else:
                    assert actual == expected

for fn in (rolling_median, window_distinct_counts):
    for window in (0, -1, -100):
        try:
            fn([1, 2], window)
        except ValueError as exc:
            assert str(exc) == 'window must be positive'
        else:
            raise AssertionError(('missing ValueError', fn.__name__, window))

print(f'passed {median_cases} median and {distinct_cases} distinct randomized cases')
