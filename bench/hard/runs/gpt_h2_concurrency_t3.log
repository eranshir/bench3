/bin/zsh -lc "python3 - <<'PY'
import threading
import time
from pipeline import Ledger, WorkerPool

# Same-account transfers used to acquire the same non-reentrant lock twice.
ledger = Ledger({'a': 10, 'b': 0})
thread = threading.Thread(target=lambda: ledger.transfer('a', 'a', 3))
thread.start(); thread.join(1)
assert not thread.is_alive()
assert ledger.balances == {'a': 10, 'b': 0}
assert ledger.transfer('a', 'b', 11) is False
assert ledger.balances == {'a': 10, 'b': 0}

# Exceptions cannot kill a worker and silently lose the remaining results.
pool = WorkerPool(3)
pool.submit(lambda: 1)
pool.submit(lambda: (_ for _ in ()).throw(RuntimeError('boom')))
pool.submit(lambda: 3)
results = pool.run()
assert len(results) == 3
assert {x for x in results if isinstance(x, int)} == {1, 3}
assert sum(isinstance(x, RuntimeError) for x in results) == 1
pool.submit(lambda: 4)
assert len(pool.run()) == 4

# Worker functions overlap: the synchronization locks do not wrap fn().
barrier = threading.Barrier(4)
pool = WorkerPool(4)
for _ in range(4):
    pool.submit(lambda: barrier.wait(timeout=1))
assert len(pool.run()) == 4

# Repeated mixed ledger operations retain funds and finish.
for _ in range(20):
    ledger = Ledger({'a': 1000, 'b': 1000, 'c': 1000})
    threads = [
        threading.Thread(target=lambda: [ledger.transfer('a', 'b', 1) for _ in range(500)]),
        threading.Thread(target=lambda: [ledger.transfer('b', 'c', 1) for _ in range(500)]),
        threading.Thread(target=lambda: [ledger.transfer('c', 'a', 1) for _ in range(500)]),
    ]
    for item in threads: item.start()
    for item in threads: item.join(2)
    assert all(not item.is_alive() for item in threads)
    assert ledger.total() == 3000
print('targeted concurrency checks: ok')
