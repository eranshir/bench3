/bin/zsh -lc "cat > /tmp/verify_analytics2.py <<'EOF'
import math
import random

from analytics import rolling_median, window_distinct_counts


def orig_rolling_median(values, window):
    if window <= 0:
        raise ValueError(\"window must be positive\")
    out = []
    for i in range(len(values) - window + 1):
        chunk = sorted(values[i:i + window])
        mid = window // 2
        if window % 2:
            out.append(float(chunk[mid]))
        else:
            out.append((chunk[mid - 1] + chunk[mid]) / 2.0)
    return out


def orig_distinct(values, window):
    if window <= 0:
        raise ValueError(\"window must be positive\")
    return [len(set(values[i:i + window]))
            for i in range(len(values) - window + 1)]


def same_value(a, b):
    if isinstance(a, float) and isinstance(b, float) and math.isnan(a) and math.isnan(b):
        return True
    return a == b


def same_list(a, b):
    return len(a) == len(b) and all(same_value(x, y) for x, y in zip(a, b))


def check(fn, orig, *args):
    try:
        expected = orig(*args)
        expected_err = None
    except Exception as e:
        expected = None
        expected_err = type(e)
    try:
        got = fn(*args)
        got_err = None
    except Exception as e:
        got = None
        got_err = type(e)
    if expected_err is not None or got_err is not None:
        if expected_err "'!= got_err:
            return False, f"error mismatch: expected {expected_err}, got {got_err} args={args!r}"
        return True, None
    if not same_list(expected, got):
        return False, f"value mismatch: expected {expected!r} got {got!r} args={args!r}"
    return True, None


rng = random.Random(99)
cases = 0

# --- random numeric cases ---
for trial in range(1200):
    n = rng.randint(0, 120)
    w = rng.randint(-3, 60)
    style = rng.choice(["int", "float", "mixed", "dup", "neg", "bool", "tiny_float", "dup_float"])
    if style == "int":
        vals = [rng.randint(-50, 50) for _ in range(n)]
    elif style == "float":
        vals = [round(rng.uniform(-50, 50), 3) for _ in range(n)]
    elif style == "mixed":
        vals = [rng.choice([rng.randint(-5, 5), round(rng.uniform(-5, 5), 2)]) for _ in range(n)]
    elif style == "dup":
        pool = [rng.randint(0, 4) for _ in range(5)]
        vals = [rng.choice(pool) for _ in range(n)]
    elif style == "neg":
        vals = [rng.randint(-5, 5) * rng.choice([-1, 1, 1]) for _ in range(n)]
    elif style == "bool":
        vals = [rng.choice([True, False, 0, 1]) for _ in range(n)]
    elif style == "tiny_float":
        vals = [round(rng.uniform(-1e-6, 1e-6), 10) for _ in range(n)]
    else:
        vals = [rng.choice([round(rng.uniform(-3, 3), 1), -0.0, 0.0, rng.randint(-2, 2)]) for _ in range(n)]
    for fn, orig in ((rolling_median, orig_rolling_median),
                     (window_distinct_counts, orig_distinct)):
        ok, msg = check(fn, orig, vals, w)
        if not ok:
            print("FAIL", fn.__name__, msg)
            raise SystemExit(1)
        cases += 1

# --- NaN with mixed object identity ---
nanA = float("nan")
nanB = float("nan")
nanC = float("nan")
all_vals = [nanA, nanB, 1, 2, nanA, nanC, 3, 1, nanB, nanA, nanC, nanB, 4]
for w in range(1, len(all_vals) + 2):
    for fn, orig in ((rolling_median, orig_rolling_median),
                     (window_distinct_counts, orig_distinct)):
        ok, msg = check(fn, orig, all_vals, w)
        if not ok:
            print("FAIL nan identity", fn.__name__, msg)
            raise SystemExit(1)
        cases += 1

# random NaN-ish lists with a mix of same/different nan objects
for trial in range(300):
    n = rng.randint(1, 60)
    w = rng.randint(1, 25)
    pool = [float("nan"), nanA, rng.randint(0, 3), rng.random()]
    vals = [rng.choice(pool) for _ in range(n)]
    for fn, orig in ((rolling_median, orig_rolling_median),
                     (window_distinct_counts, orig_distinct)):
        ok, msg = check(fn, orig, vals, w)
        if not ok:
            print("FAIL nan random", fn.__name__, msg)
            raise SystemExit(1)
        cases += 1

# --- inf / -0.0 stress for median ordering ---
vals = []
for k in range(80):
    vals.extend([rng.choice([0.0, -0.0]), rng.randint(-2, 2), rng.choice([float("inf"), float("-inf")])])
for w in [1, 2, 3, 4, 5, 7, 10, 15]:
    for fn, orig in ((rolling_median, orig_rolling_median),
                     (window_distinct_counts, orig_distinct)):
        ok, msg = check(fn, orig, vals, w)
        if not ok:
            print("FAIL zeros/inf", fn.__name__, msg)
            raise SystemExit(1)
        cases += 1

# --- explicit edge/error cases ---
edge_args = [
