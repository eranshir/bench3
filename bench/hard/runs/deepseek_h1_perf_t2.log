            print("FAIL edge", fn.__name__, msg)
            raise SystemExit(1)
        cases += 1

# --- strings / unhashable ---
for vals, w in [(["1", "2", "3"], 3), (["1.5", "2.5"], 1), (["10", "20", "30", "40"], 2),
                (["1"], 1), (["a", "b", "c"], 3), (["1", "2"], 5),
                ([(1,), (2,), (1,)], 2), ([(1, 2), (1, 2), (3,)], 2),
                ([[1], [2]], 1), ([[1], [2], [1]], 3), ([{1}, {2}], 1)]:
    for fn, orig in ((rolling_median, orig_rolling_median),
                     (window_distinct_counts, orig_distinct)):
        ok, msg = check(fn, orig, vals, w)
        if not ok:
            print("FAIL str/unhash", fn.__name__, msg)
            raise SystemExit(1)
        cases += 1

print(f"All {cases} checks passed.")
