    ([1], 1), ([1], 2), ([1, 2, 3], 3), ([1, 2, 3], 4), ([1, 2, 3], 1),
    ([1, 2, 3], 0), ([1, 2, 3], -1),
    ([1, 2, 3], 2.5), ([1], 2.0), ([], 2.0), ([1, 2], 2.0),
    ([1, 2, 3], "3"), ([1, 2, 3], None), ([1, 2, 3], 2 + 0j),
    ([1, 2, 3], True), ([1, 2, 3], False),
    ("abc", 2), ("abc", 1), ("123", 2), ("abc", 5),
    ((1, 2, 3), 2), (range(5), 2),
    ([1, 2], 3.0), ([], 3.0),
