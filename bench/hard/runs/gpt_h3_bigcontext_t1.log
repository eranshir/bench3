python3 - <<'PY'
from decimal import Decimal

from ledgerkit import catalog, fx, pricing, reporting, repository, tax, tenants
from ledgerkit.money import CURRENCY_DECIMALS, Money
from ledgerkit.tenants import Tenant

cat = catalog.default_catalog()
expected = {
    \"acme\": {
        \"rows\": {
            \"A-1001\": (\"244.68\", \"244.68\"),
            \"A-1002\": (\"1174.50\", \"1174.50\"),
            \"A-1003\": (\"195.46\", \"212.46\"),
            \"A-1004\": (\"341.28\", \"432.00\"),
        },
        \"total\": \"2063.64\",
    },
    \"kitsune\": {
        \"rows\": {
            \"K-3001\": (\"98439\", \"98439\"),
            \"K-3002\": (\"43120\", \"43120\"),
            \"K-3003\": (\"228.38\", \"35856\"),
        },
        \"total\": \"177415\",
    },
}

for tenant_id, wanted in expected.items():
    tenant = tenants.get(tenant_id)
    report = reporting.tenant_report(
        tenant, repository.for_tenant(tenant_id), cat)
    assert str(report[\"total\"].amount) == wanted[\"total\"]
    for row in report[\"rows\"]:
        actual = (str(row[\"total\"].amount), str(row[\"reported\"].amount))
        assert actual == wanted[\"rows\"][row[\"order_id\"]], (row[\"order_id\"], actual)

# The quoted rates are target-currency units per USD, so every cross-rate
# must be target/source, for every supported pair.
for source in fx.supported():
    for target in fx.supported():
        converted = fx.convert(Money(\"1\", source), target)
        assert converted.amount == fx.RATES[target] / fx.RATES[source]
        assert converted.currency == target

# Pricing components must obey taxable = subtotal - discount and
# tax = taxable * region rate for every order, including capped/fixed rules.
for tenant in tenants.all_tenants():
    orders = repository.for_tenant(tenant.tenant_id)
    for order in orders:
        parts = pricing.price_breakdown(order, cat, tenant)
        assert parts[\"taxable\"] == parts[\"subtotal\"] - parts[\"discount\"]
        assert parts[\"tax\"] == parts[\"taxable\"] * tax.rate_for(order.region)
        assert pricing.order_tax(order, cat, tenant) == parts[\"tax\"]
        assert parts[\"total\"] == (parts[\"taxable\"] + parts[\"tax\"]).quantized()

    # Exercise each configured tenant's orders under every supported report
    # currency, including CHF and zero-minor-unit JPY.
    for report_currency in CURRENCY_DECIMALS:
        variant = Tenant(tenant.tenant_id, tenant.name, tenant.home_region,
                         report_currency, tenant.discount_rules)
        report = reporting.tenant_report(variant, orders, cat)
        values = [report[\"total\"]] + [r[\"reported\"] for r in report[\"rows\"]]
        assert all(value.currency == report_currency for value in values)
        assert all(value.is_quantized() for value in values)

print(\"all reconciliation, pricing, FX-pair, and currency-precision checks passed\")
PY
