    (\"country in ['US', 'CA']\", {\"country\": \"CA\"}, True),
    (\"customer.plan == 'pro'\", {\"customer\": {\"plan\": \"pro\"}}, True),
    (\"name startswith 'Al' and name endswith 'ce'\", {\"name\": \"Alice\"}, True),
    (\"deleted_at is null\", {\"deleted_at\": None}, True),
    (\"missing "'!= 3", {}, False),
    ("age > '"'old'\", {\"age\": 30}, False),
    (\"false or true and false\", {}, False),
