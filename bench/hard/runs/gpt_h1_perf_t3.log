import math
import random
import struct
from analytics import rolling_median, window_distinct_counts


def ref_median(values, window):
    if window <= 0:
        raise ValueError(\"window must be positive\")
    out = []
    for i in range(len(values) - window + 1):
        chunk = sorted(values[i:i + window])
        mid = window // 2
        if window % 2:
            out.append(float(chunk[mid]))
        else:
            out.append((chunk[mid - 1] + chunk[mid]) / 2.0)
    return out


def ref_distinct(values, window):
    if window <= 0:
        raise ValueError(\"window must be positive\")
    return [len(set(values[i:i + window]))
            for i in range(len(values) - window + 1)]


def float_key(x):
    if isinstance(x, float):
        return struct.pack('>d', x)
    return x

rng = random.Random(919)
pool = [-10**400, -10**20, -3, -1, 0, 1, 2, 10**20, 10**400,
        -math.inf, -3.5, -0.0, 0.0, 1.0, 2.5, math.inf, False, True]
for n in range(0, 60):
    for _ in range(80):
        values = [rng.choice(pool) for _ in range(n)]
        window = rng.randrange(1, n + 5)
        try:
            got = rolling_median(values, window)
        except Exception as e1:
            try:
                ref_median(values, window)
            except Exception as e2:
                assert (type(e1), str(e1)) == (type(e2), str(e2)), (values, window, e1, e2)
            else:
                raise AssertionError((values, window, e1))
        else:
            expected = ref_median(values, window)
            assert list(map(float_key, got)) == list(map(float_key, expected)), (values, window, got, expected)

nan1 = float('nan')
nan2 = float('nan')
complex_nan = complex(float('nan'), 0)
dpool = pool + [nan1, nan1, nan2, complex_nan, complex_nan, 1+0j]
for n in range(0, 80):
    for _ in range(80):
        values = [rng.choice(dpool) for _ in range(n)]
        window = rng.randrange(1, n + 5)
        assert window_distinct_counts(values, window) == ref_distinct(values, window)

for fn in (rolling_median, window_distinct_counts):
    for window in (0, -1, -100):
        try:
            fn([1, 2], window)
        except ValueError as exc:
            assert str(exc) == 'window must be positive'
        else:
            raise AssertionError((fn, window))

class BadHash:
    def __hash__(self):
        raise RuntimeError('hash failed')

try:
    window_distinct_counts([BadHash()], 1)
except RuntimeError as exc:
    assert str(exc) == 'hash failed'
else:
    raise AssertionError('fallback error changed')

print('randomized differential tests passed')
