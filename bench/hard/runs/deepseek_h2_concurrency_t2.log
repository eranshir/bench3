import threading
from pipeline import Ledger, WorkerPool

# 1) Overdraw must be refused atomically under race.
led = Ledger({\"a\": 100, \"b\": 0})
fail = [0]
def drainer():
    for _ in range(100_000):
        if not led.transfer(\"a\", \"b\", 1):
            fail[0] += 1
threads = [threading.Thread(target=drainer) for _ in range(8)]
for t in threads: t.start()
for t in threads: t.join()
assert led.total() == 100, led.total()
assert led.balances[\"b\"] == 100, led.balances
# Refusal on its own.
assert led.transfer(\"b\", \"a\", 1) is True
assert led.transfer(\"a\", \"b\", 101) is False
assert led.balances == {\"a\": 100, \"b\": 0}, led.balances
print(\"overdraw: ok\")

# 2) Deposit total and audit consistency.
led = Ledger({\"x\": 0})
def dep():
    for _ in range(5_000):
        led.deposit(\"x\", 1)
threads = [threading.Thread(target=dep) for _ in range(8)]
for t in threads: t.start()
for t in threads: t.join()
assert led.balances[\"x\"] == 40_000
assert len(led.audit) == 40_000
# audit entries must be internally consistent and monotonically reachable
