    expected += entry[\"amount\"]
    assert entry[\"balance_after\"] == expected
print(\"deposits/audit: ok\")

# 3) Pool returns one ordered result per submitted task, repeatedly.
p = WorkerPool(8)
for i in range(1_000):
    p.submit(lambda i=i: i * 2)
assert p.run() == [i * 2 for i in range(1_000)]
for i in range(3):
    p.submit(lambda i=i: -i)
assert p.run() == [0, -1, -2]
print(\"pool order/reuse: ok\")

# 4) A failing task surfaces instead of hanging / losing results.
p = WorkerPool(4)
p.submit(lambda: 1)
p.submit(lambda: (_ for _ in ()).throw(ValueError(\"boom\")))
p.submit(lambda: 2)
try:
    p.run()
    raise AssertionError(\"expected ValueError\")
except ValueError as e:
    assert str(e) == \"boom\"
print(\"pool error propagation: ok\")
