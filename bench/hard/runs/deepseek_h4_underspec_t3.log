+
+
+def _resolve(record, path):
+    """Resolve a field path, reading missing values as null."""
+    if path in record:
+        return record[path]
+    value = record
+    for part in path.split("."):
+        if isinstance(value, dict) and part in value:
+            value = value[part]
+        else:
