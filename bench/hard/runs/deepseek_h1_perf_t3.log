+++ b/scratch.py
@@ -0,0 +1,302 @@
+import bisect
+import heapq
+import random
+import time
+
+from collections import Counter
+
+
+def orig_rolling_median(values, window):
+    if window <= 0:
+        raise ValueError("window must be positive")
+    out = []
+    for i in range(len(values) - window + 1):
+        chunk = sorted(values[i:i + window])
+        mid = window // 2
+        if window % 2:
+            out.append(float(chunk[mid]))
+        else:
+            out.append((chunk[mid - 1] + chunk[mid]) / 2.0)
+    return out
+
+
+def sortedlist_rolling_median(values, window):
+    if window <= 0:
+        raise ValueError("window must be positive")
+    n = len(values)
+    out_len = n - window + 1
+    if out_len <= 0:
+        return []
+    out = []
+    window_list = sorted(values[:window])
+    mid = window // 2
+    odd = window % 2
+    if odd:
+        out.append(float(window_list[mid]))
+    else:
+        out.append((window_list[mid - 1] + window_list[mid]) / 2.0)
+    for i in range(window, n):
+        bisect.insort(window_list, values[i])
+        j = bisect.bisect_left(window_list, values[i - window])
+        del window_list[j]
+        if odd:
+            out.append(float(window_list[mid]))
+        else:
+            out.append((window_list[mid - 1] + window_list[mid]) / 2.0)
+    return out
+
+
+def heap_rolling_median(values, window):
+    if window <= 0:
+        raise ValueError("window must be positive")
+    n = len(values)
+    out_len = n - window + 1
+    if out_len <= 0:
+        return []
+    low = []   # max-heap via negation
+    high = []  # min-heap
+    pending = {}
+    out = []
+
+    def clean():
+        while low:
+            x = -low[0]
+            if pending.get(x, 0):
+                heapq.heappop(low)
+                pending[x] -= 1
+            else:
+                break
+        while high:
+            x = high[0]
+            if pending.get(x, 0):
+                heapq.heappop(high)
+                pending[x] -= 1
+            else:
+                break
+
+    def add(x):
+        clean()
+        if not low or x <= -low[0]:
+            heapq.heappush(low, -x)
+        else:
+            heapq.heappush(high, x)
+        rebalance()
+
+    def remove(x):
+        pending[x] = pending.get(x, 0) + 1
+        rebalance()
+
+    def rebalance():
+        clean()
+        # ordering: every element in low <= every element in high
+        while low and high and -low[0] > high[0]:
+            heapq.heappush(high, -heapq.heappop(low))
+            clean()
+        # sizes: len(low) == len(high) or len(low) == len(high) + 1
+        while len(low) > len(high) + 1:
+            heapq.heappush(high, -heapq.heappop(low))
+            clean()
+        while len(high) > len(low):
+            heapq.heappush(low, -heapq.heappop(high))
+            clean()
+
+    for x in values[:window]:
+        add(x)
+    mid = window // 2
+    odd = window % 2
+    if odd:
+        out.append(float(-low[0]))
+    else:
+        out.append((-low[0] + high[0]) / 2.0)
+    for i in range(window, n):
+        remove(values[i - window])
+        add(values[i])
+        if odd:
+            out.append(float(-low[0]))
+        else:
+            out.append((-low[0] + high[0]) / 2.0)
+    return out
+
+
+def fenwick_rolling_median(values, window):
+    if window <= 0:
+        raise ValueError("window must be positive")
+    n = len(values)
+    out_len = n - window + 1
+    if out_len <= 0:
+        return []
+    order = sorted(set(values))
+    index = {v: i + 1 for i, v in enumerate(order)}
+    size = len(order)
+    tree = [0] * (size + 1)
+
+    def update(i, delta):
+        while i <= size:
+            tree[i] += delta
+            i += i & -i
+
+    def kth(k):
+        # 1-indexed k-th smallest
+        pos = 0
+        bit = 1 << (size.bit_length() - 1)
+        while bit:
+            nxt = pos + bit
+            if nxt <= size and tree[nxt] < k:
+                pos = nxt
+                k -= tree[nxt]
+            bit >>= 1
+        return order[pos]
+
+    for x in values[:window]:
+        update(index[x], 1)
+    out = []
+    odd = window % 2
+    if odd:
+        out.append(float(kth(window // 2 + 1)))
+    else:
+        a = kth(window // 2)
+        b = kth(window // 2 + 1)
+        out.append((a + b) / 2.0)
+    for i in range(window, n):
+        update(index[values[i - window]], -1)
+        update(index[values[i]], 1)
+        if odd:
+            out.append(float(kth(window // 2 + 1)))
+        else:
+            a = kth(window // 2)
+            b = kth(window // 2 + 1)
+            out.append((a + b) / 2.0)
+    return out
+
+
+def orig_distinct(values, window):
+    if window <= 0:
+        raise ValueError("window must be positive")
+    return [len(set(values[i:i + window]))
+            for i in range(len(values) - window + 1)]
+
+
+def sliding_distinct(values, window):
+    if window <= 0:
