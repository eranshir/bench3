+        counts[entering] = c + 1
+        if c == 0:
+            distinct += 1
+        out.append(distinct)
+    return out
+
+
+def check_eq(a, b, label):
+    if a != b:
+        print(f"MISMATCH {label}")
+        for i, (x, y) in enumerate(zip(a, b)):
+            if x != y:
+                print("  first diff at", i, x, y)
+                break
+        print("  lens:", len(a), len(b))
+        return False
+    return True
+
+
+rng = random.Random(123)
+med_impls = {
+    "sortedlist": sortedlist_rolling_median,
+    "heap": heap_rolling_median,
+    "fenwick": fenwick_rolling_median,
