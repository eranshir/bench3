+    out_len = n - window + 1
+    if out_len <= 0:
+        return []
+    low = []   # max-heap via negation
+    high = []  # min-heap
+    pending = {}
+    out = []
+
+    def clean():
+        while low:
+            x = -low[0]
+            if pending.get(x, 0):
+                heapq.heappop(low)
+                pending[x] -= 1
+            else:
+                break
+        while high:
+            x = high[0]
+            if pending.get(x, 0):
+                heapq.heappop(high)
+                pending[x] -= 1
+            else:
+                break
+
+    def add(x):
+        clean()
+        if not low or x <= -low[0]:
+            heapq.heappush(low, -x)
+        else:
+            heapq.heappush(high, x)
+        rebalance()
+
+    def remove(x):
+        pending[x] = pending.get(x, 0) + 1
+        rebalance()
+
+    def rebalance():
+        clean()
