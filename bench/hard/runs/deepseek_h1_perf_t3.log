@@ -0,0 +1,302 @@
+import bisect
+import heapq
+import random
+import time
+
+from collections import Counter
+
+
+def orig_rolling_median(values, window):
+    if window <= 0:
+        raise ValueError("window must be positive")
+    out = []
+    for i in range(len(values) - window + 1):
+        chunk = sorted(values[i:i + window])
+        mid = window // 2
+        if window % 2:
+            out.append(float(chunk[mid]))
+        else:
+            out.append((chunk[mid - 1] + chunk[mid]) / 2.0)
+    return out
+
+
+def sortedlist_rolling_median(values, window):
+    if window <= 0:
+        raise ValueError("window must be positive")
+    n = len(values)
+    out_len = n - window + 1
+    if out_len <= 0:
+        return []
+    out = []
+    window_list = sorted(values[:window])
+    mid = window // 2
+    odd = window % 2
+    if odd:
+        out.append(float(window_list[mid]))
+    else:
+        out.append((window_list[mid - 1] + window_list[mid]) / 2.0)
+    for i in range(window, n):
+        bisect.insort(window_list, values[i])
+        j = bisect.bisect_left(window_list, values[i - window])
+        del window_list[j]
+        if odd:
+            out.append(float(window_list[mid]))
+        else:
+            out.append((window_list[mid - 1] + window_list[mid]) / 2.0)
+    return out
+
+
+def heap_rolling_median(values, window):
+    if window <= 0:
+        raise ValueError("window must be positive")
+    n = len(values)
+    out_len = n - window + 1
+    if out_len <= 0:
+        return []
+    low = []   # max-heap via negation
+    high = []  # min-heap
+    pending = {}
+    out = []
+
+    def clean():
+        while low:
+            x = -low[0]
+            if pending.get(x, 0):
+                heapq.heappop(low)
+                pending[x] -= 1
+            else:
+                break
+        while high:
+            x = high[0]
+            if pending.get(x, 0):
+                heapq.heappop(high)
+                pending[x] -= 1
+            else:
+                break
+
+    def add(x):
+        clean()
+        if not low or x <= -low[0]:
+            heapq.heappush(low, -x)
+        else:
+            heapq.heappush(high, x)
+        rebalance()
+
+    def remove(x):
+        pending[x] = pending.get(x, 0) + 1
+        rebalance()
+
+    def rebalance():
+        clean()
+        # ordering: every element in low <= every element in high
+        while low and high and -low[0] > high[0]:
+            heapq.heappush(high, -heapq.heappop(low))
+            clean()
+        # sizes: len(low) == len(high) or len(low) == len(high) + 1
+        while len(low) > len(high) + 1:
+            heapq.heappush(high, -heapq.heappop(low))
+            clean()
+        while len(high) > len(low):
+            heapq.heappush(low, -heapq.heappop(high))
+            clean()
+
+    for x in values[:window]:
+        add(x)
+    mid = window // 2
+    odd = window % 2
+    if odd:
+        out.append(float(-low[0]))
+    else:
+        out.append((-low[0] + high[0]) / 2.0)
+    for i in range(window, n):
+        remove(values[i - window])
+        add(values[i])
+        if odd:
+            out.append(float(-low[0]))
+        else:
+            out.append((-low[0] + high[0]) / 2.0)
+    return out
+
+
+def fenwick_rolling_median(values, window):
+    if window <= 0:
+        raise ValueError("window must be positive")
+    n = len(values)
+    out_len = n - window + 1
+    if out_len <= 0:
+        return []
+    order = sorted(set(values))
+    index = {v: i + 1 for i, v in enumerate(order)}
+    size = len(order)
+    tree = [0] * (size + 1)
+
+    def update(i, delta):
+        while i <= size:
+            tree[i] += delta
+            i += i & -i
+
+    def kth(k):
+        # 1-indexed k-th smallest
+        pos = 0
+        bit = 1 << (size.bit_length() - 1)
+        while bit:
+            nxt = pos + bit
+            if nxt <= size and tree[nxt] < k:
+                pos = nxt
+                k -= tree[nxt]
+            bit >>= 1
+        return order[pos]
+
+    for x in values[:window]:
+        update(index[x], 1)
+    out = []
+    odd = window % 2
+    if odd:
+        out.append(float(kth(window // 2 + 1)))
+    else:
+        a = kth(window // 2)
+        b = kth(window // 2 + 1)
+        out.append((a + b) / 2.0)
+    for i in range(window, n):
+        update(index[values[i - window]], -1)
+        update(index[values[i]], 1)
+        if odd:
+            out.append(float(kth(window // 2 + 1)))
+        else:
+            a = kth(window // 2)
+            b = kth(window // 2 + 1)
+            out.append((a + b) / 2.0)
+    return out
+
+
+def orig_distinct(values, window):
+    if window <= 0:
+        raise ValueError("window must be positive")
+    return [len(set(values[i:i + window]))
+            for i in range(len(values) - window + 1)]
+
+
+def sliding_distinct(values, window):
+    if window <= 0:
+        raise ValueError("window must be positive")
+    n = len(values)
+    out_len = n - window + 1
+    if out_len <= 0:
+        return []
+    counts = {}
+    distinct = 0
+    for x in values[:window]:
+        c = counts.get(x, 0)
+        counts[x] = c + 1
+        if c == 0:
+            distinct += 1
+    out = [distinct]
+    for i in range(window, n):
+        leaving = values[i - window]
+        c = counts[leaving] - 1
+        if c:
+            counts[leaving] = c
+        else:
+            del counts[leaving]
+            distinct -= 1
+        entering = values[i]
+        c = counts.get(entering, 0)
+        counts[entering] = c + 1
+        if c == 0:
+            distinct += 1
+        out.append(distinct)
+    return out
+
+
+def check_eq(a, b, label):
+    if a != b:
+        print(f"MISMATCH {label}")
+        for i, (x, y) in enumerate(zip(a, b)):
+            if x != y:
+                print("  first diff at", i, x, y)
+                break
+        print("  lens:", len(a), len(b))
+        return False
+    return True
+
+
+rng = random.Random(123)
+med_impls = {
+    "sortedlist": sortedlist_rolling_median,
+    "heap": heap_rolling_median,
+    "fenwick": fenwick_rolling_median,
+}
+
+# correctness sweep
+cases = [
+    ([], 3), ([1], 1), ([1, 2, 3], 3), ([1, 2, 3], 4), ([1, 2, 3], 1),
+    ([5, 5, 5, 5], 2), ([3, 1, 2], 2), ([1, 2, 3, 4], 4),
+    ([1.5, 2.5, 3.5], 2), ([-5, -1, -3], 2),
+]
+for _ in range(200):
+    n = rng.randint(0, 40)
+    cases.append([rng.randint(-20, 20) for _ in range(n)])
+for _ in range(100):
+    n = rng.randint(0, 40)
+    cases.append([round(rng.uniform(-100, 100), 3) for _ in range(n)])
+
+ok = True
+for case in cases:
+    values = case[0] if isinstance(case, tuple) else case
+    for w in [1, 2, 3, 4, 5, 7, 13, 40, 50]:
+        expected = orig_rolling_median(values, w)
+        for name, fn in med_impls.items():
+            got = fn(values, w)
+            if got != expected:
+                ok = False
+                print(f"FAIL {name} w={w} vals={values[:10]}...")
+                break
+    # error behaviour
+    for w in [0, -1, -5]:
+        for name, fn in med_impls.items():
+            try:
+                fn(values, w)
+                print(f"FAIL {name} no error for w={w}")
+                ok = False
+            except ValueError:
+                pass
+
+for case in cases:
+    values = case[0] if isinstance(case, tuple) else case
+    for w in [1, 2, 3, 5, 8, 13, 40, 50]:
+        expected = orig_distinct(values, w)
+        got = sliding_distinct(values, w)
+        if got != expected:
+            ok = False
+            print(f"FAIL distinct w={w}")
+    for w in [0, -1]:
+        try:
+            sliding_distinct(values, w)
+            print(f"FAIL distinct no error w={w}")
+            ok = False
+        except ValueError:
+            pass
+
+print("correctness:", "OK" if ok else "FAILED")
+
+
+# performance
+random.seed(7)
+series = [random.randint(0, 10_000) for _ in range(100_000)]
+series2 = [random.randint(0, 500) for _ in range(200_000)]
+
+for name, fn in med_impls.items():
+    t = time.perf_counter()
+    out = fn(series, 1001)
+    print(f"{name:>12} median 100k w=1001: {time.perf_counter() - t:6.2f}s ({len(out)})")
+
+t = time.perf_counter()
+out = sliding_distinct(series2, 2001)
+print(f"sliding distinct 200k w=2001: {time.perf_counter() - t:6.2f}s ({len(out)})")
+
+# big-window stress for heap vs sortedlist
+big = [random.randint(0, 100_000) for _ in range(20_000)]
+for name, fn in med_impls.items():
+    t = time.perf_counter()
+    out = fn(big, 10_000)
+    print(f"{name:>12} median 20k w=10000: {time.perf_counter() - t:6.2f}s ({len(out)})")

