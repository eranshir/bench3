"""Timing harness. Run: python3 bench.py"""
import random
import time

from analytics import rolling_median, window_distinct_counts

random.seed(7)


def timed(label, fn, *a):
    t = time.perf_counter()
    out = fn(*a)
    print(f"{label:<28} {time.perf_counter() - t:8.2f}s  ({len(out)} results)")
    return out


