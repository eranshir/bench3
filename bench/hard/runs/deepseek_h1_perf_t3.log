+    index = {v: i + 1 for i, v in enumerate(order)}
+    size = len(order)
+    tree = [0] * (size + 1)
+
+    def update(i, delta):
+        while i <= size:
+            tree[i] += delta
+            i += i & -i
+
+    def kth(k):
+        # 1-indexed k-th smallest
+        pos = 0
