+class _StartsWith:
+    def __init__(self, left, right, negate=False):
+        self.left = left
+        self.right = right
+        self.negate = negate
+
+    def eval(self, record):
+        left = _as_value(self.left, record)
+        right = _as_value(self.right, record, fallback=True)
