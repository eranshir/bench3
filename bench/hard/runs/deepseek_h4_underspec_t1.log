+        while self._accept_kw("and"):
+            node = _And(node, self._parse_not())
+        return node
+
+    def _parse_not(self):
+        if self._accept_kw("not"):
+            return _Not(self._parse_not())
+        return self._parse_comparison()
+
+    def _parse_comparison(self):
