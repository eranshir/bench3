    (\"not tags contains 'vip'\", {\"tags\": [\"vip\", \"beta\"]}, False),
    (\"tags contains vip\", {\"tags\": [\"vip\", \"beta\"]}, True),
    (\"city in ('NY', 'LA')\", {\"city\": \"NY\"}, True),
    (\"city not in ('NY', 'LA')\", {\"city\": \"SF\"}, True),
    (\"city in ['NY', 'LA']\", {\"city\": \"SF\"}, False),
