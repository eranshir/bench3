+            path = [token.value]
+            original = token.value
+            while self._accept("dot"):
+                name = self._next()
+                if name.kind != "ident":
+                    raise ValueError(
+                        f"expected a field name after '.', got {name.value!r}"
+                    )
+                path.append(name.value)
+                original += "." + name.value
