+      | (?P<op><=|>=|==|!=|=|<|>)
+      | (?P<lparen>\()
+      | (?P<rparen>\))
+      | (?P<lbracket>\[)
+      | (?P<rbracket>\])
+      | (?P<comma>,)
+      | (?P<dot>\.)
+      | (?P<ident>[A-Za-z_][A-Za-z0-9_]*)
+      | (?P<error>.)
