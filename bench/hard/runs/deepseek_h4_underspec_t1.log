+        match = _TOKEN_RE.match(text, pos)
+        if match is None or match.end() == pos:
+            raise ValueError(
+                f"invalid character at position {pos} in filter expression {text!r}"
+            )
+        kind = match.lastgroup
+        if kind == "error":
+            raise ValueError(
